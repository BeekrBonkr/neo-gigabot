# Optional - shown in /about. A permanent Discord invite link to your support server.
SUPPORT_SERVER_INVITE=

# Optional - root directory of the OLD gigabot install (the one containing storage/settings/,
# storage/playlists.yml, etc). Used by /owner migrate and scripts/migrate_legacy_data.py. Defaults
# to a sibling "gigabot" directory next to this project if unset.
LEGACY_DATA_PATH=
