DISCORD_TOKEN=your_bot_token_here
OWNER_ID=193534159212249090
LOG_LEVEL=INFO

# Optional - /weather is disabled until this is set. Get a free key at https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=

# Optional - /gif, /cute, /beans are disabled until this is set. Get a free key at https://developers.giphy.com/
GIPHY_API_KEY=

# Optional - /meme, /reddit and /cursed read Reddit through its API when these are set. Without them the bot
# uses Reddit's public pages, which Reddit refuses from many servers. Create a "script" app at
# https://www.reddit.com/prefs/apps and copy its ID (under the app's name) and secret.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional - how the bot names itself to Reddit, for example: discord:my-bot:v1 (by /u/yourname)
REDDIT_USER_AGENT=

# Optional - shown in /about. A permanent Discord invite link to your support server.
SUPPORT_SERVER_INVITE=

# Optional - the address of the bot's website (neogigabot-panel's public site), such as
# https://example.com. When set, /about, /help, /settings, the music embeds and a few other
# places link to it so members and admins know it exists. Leave empty if you don't run the site.
WEBSITE_URL=

# Optional - set to 1 on a test copy of the bot (a separate Discord application running the
# development branch). /about and /help then warn that it is a beta build whose data may be reset.
BETA_BUILD=

# Optional - root directory of the OLD gigabot install (the one containing storage/settings/,
# storage/playlists.yml, etc). Used by /owner migrate and scripts/migrate_legacy_data.py. Defaults
# to a sibling "gigabot" directory next to this project if unset.
LEGACY_DATA_PATH=

# Optional - enables the localhost-only control API used by the owner web panel
# (neogigabot-panel). Leave the token empty to keep the bridge off. Must be 32+
# characters and match BRIDGE_TOKEN in the panel's .env.
PANEL_BRIDGE_TOKEN=
PANEL_BRIDGE_PORT=8791
