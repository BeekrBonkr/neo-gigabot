# Oneshot unit driven by neo-gigabot-ytdlp-update.timer. Upgrades yt-dlp in the
# bot's venv and restarts neo-gigabot only when the version changed.
#
# Install (alongside neo-gigabot.service):
#   sudo cp neo-gigabot-ytdlp-update.service neo-gigabot-ytdlp-update.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now neo-gigabot-ytdlp-update.timer
#   systemctl list-timers neo-gigabot-ytdlp-update.timer   # confirm next run
#   sudo systemctl start neo-gigabot-ytdlp-update.service  # dry run now
#
# The script runs as the bot's own user, never as root: it lives in that user's
# checkout, so root running it would hand root to anything that can write
# there. It leaves a marker when yt-dlp changed, and the one step that needs
# root, restarting the bot, is the fixed command in ExecStartPost ("+" runs
# that line with full privileges). Change User= and the paths to match yours.

[Unit]
Description=Upgrade yt-dlp for neo-GigaBot and restart if changed
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=michael
WorkingDirectory=/home/michael/neogigabot
RuntimeDirectory=neo-gigabot-ytdlp
Environment=YTDLP_CHANGED_MARKER=/run/neo-gigabot-ytdlp/changed
ExecStart=/home/michael/neogigabot/scripts/update_ytdlp.sh
ExecStartPost=+/bin/sh -c 'if [ -e /run/neo-gigabot-ytdlp/changed ]; then /usr/bin/systemctl try-restart neo-gigabot.service; fi'
NoNewPrivileges=yes
